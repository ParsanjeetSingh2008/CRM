# Copy this file to `.env` and adjust as needed. Every value has a safe local
# default, so the API also runs without a .env file (Clive needs a key, though).
# Never put real keys in THIS file: it is committed to git. `.env` is not.

# development | production
ENVIRONMENT=development

# Local SQLite file (created automatically on first start).
DATABASE_URL=sqlite:///./crm.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Signs login sessions. REQUIRED in production (32+ random characters), e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Clive, the AI assistant (runs on Groq). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides:
# CLIVE_MODEL=openai/gpt-oss-120b
# CLIVE_REASONING_EFFORT=medium
